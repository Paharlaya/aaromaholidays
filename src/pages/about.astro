---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { whatsappLink } from '../data/site';

const services = [
  { title: 'Tour packages', text: 'Planned trips across Darjeeling, Sikkim, Kalimpong and the Dooars, changed to fit your dates, pace and budget.' },
  { title: 'Cabs and transfers', text: 'Pick-ups and drops at Bagdogra airport and NJP station, plus cabs by the day for sightseeing.' },
  { title: 'Hotels and homestays', text: 'Rooms booked at places we know, from simple homestays to hotels with a mountain view.' },
  { title: 'Permits', text: 'Paperwork for North Sikkim, Tsomgo Lake and Nathula Pass, sorted before you arrive.' },
];
---

<Base
  title="About us"
  description="Aaroma Holidays is a local tour and transport company in Bijanbari, Darjeeling, running trips across Darjeeling and Sikkim."
>
  <header class="page-head wrap">
    <h1>A local team in the Darjeeling hills</h1>
    <p class="lede">
      Aaroma Holidays is a tour and transport company from Chainpura Gram, Bijanbari. We plan trips
      across Darjeeling and Sikkim and run them with our own drivers and ground team.
    </p>
  </header>

  <div class="wrap">
    <div class="cover">
      <Photo alt="The Aaroma Holidays team" label="The Aaroma team, outdoors in Bijanbari" tone="dawn" ratio="21 / 9" eager />
    </div>
  </div>

  <section class="section" aria-labelledby="story-title">
    <div class="wrap story">
      <h2 id="story-title">Why we started</h2>
      <div class="story-text">
        <!-- TODO: replace with the founders' own story. -->
        <p>
          Most visitors see Darjeeling and Sikkim through a cab window. We wanted to plan trips the way
          we’d show the hills to our own family: early starts for the clear mountain views, the right
          day for the high passes, and enough time at each place to enjoy it.
        </p>
        <p>
          We still work that way. Every trip is planned by someone who lives here and driven by someone
          who knows the road.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--wash" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-title">What we do</h2>
      </div>
      <dl class="services">
        {services.map((s) => (
          <div>
            <dt>{s.title}</dt>
            <dd>{s.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="b2b-title">
    <div class="wrap b2b">
      <div class="b2b-media">
        <Photo alt="A fleet of cabs ready for guests" label="Cabs lined up for a group pick-up" tone="mist" ratio="4 / 3" />
      </div>
      <div class="b2b-text">
        <h2 id="b2b-title">For travel agents</h2>
        <p class="lede">
          Sending guests to Darjeeling, Sikkim or Kalimpong? We provide cabs, transfers and on-ground
          support for agencies, so your guests are looked after from arrival to departure.
        </p>
        <a class="btn btn--teal" href={whatsappLink('Hi Aaroma Holidays, I am a travel agent and would like to discuss B2B transport.')} target="_blank" rel="noopener">
          Talk to us about B2B
        </a>
      </div>
    </div>
  </section>

  <EnquiryBand />
</Base>

<style>
  .cover { border-radius: var(--radius-lg); overflow: hidden; }

  .story {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2rem clamp(2rem, 1rem + 5vw, 6rem);
  }
  .story-text { display: grid; gap: 1.25rem; max-width: 60ch; font-size: var(--step-1); line-height: 1.55; }

  .services {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin: 0;
  }
  .services > div { padding-top: 1.25rem; border-top: 1px solid rgb(11 93 91 / 0.25); }
  .services dt {
    margin-bottom: 0.5rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--step-2);
  }
  .services dd { margin: 0; }

  .b2b {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: center;
  }
  .b2b-media { border-radius: var(--radius-lg); overflow: hidden; }
  .b2b-text { display: grid; gap: 1.5rem; justify-items: start; }

  @media (max-width: 960px) {
    .story, .b2b { grid-template-columns: 1fr; }
    .services { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .services { grid-template-columns: 1fr; }
  }
</style>
