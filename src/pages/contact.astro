---
import Base from '../layouts/Base.astro';
import { site, whatsappLink } from '../data/site';
import { packages } from '../data/packages';
---

<Base
  title="Contact"
  description="Contact Aaroma Holidays for Darjeeling and Sikkim tour quotes, cabs and transfers. WhatsApp, phone or email."
>
  <header class="page-head wrap">
    <h1>Plan your trip with us</h1>
    <p class="lede">
      Send your dates and group size and we’ll reply with a day-by-day plan and a price.
      WhatsApp is the fastest way to reach us.
    </p>
  </header>

  <section class="wrap contact" aria-label="Contact options">
    <form class="form" data-contact data-wa={site.whatsapp} aria-labelledby="form-title" novalidate>
      <h2 id="form-title">Trip details</h2>

      <div class="row">
        <div class="field">
          <label for="c-name">Your name</label>
          <input id="c-name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="c-phone">Phone</label>
          <input id="c-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
      </div>

      <div class="field">
        <label for="c-trip">Trip you’re interested in</label>
        <select id="c-trip" name="trip">
          <option>Not sure yet, please suggest</option>
          {packages.map((p) => <option>{p.title} ({p.duration})</option>)}
        </select>
      </div>

      <div class="row">
        <div class="field">
          <label for="c-date">Arrival date</label>
          <input id="c-date" name="date" type="date" />
        </div>
        <div class="field">
          <label for="c-people">Travellers</label>
          <input id="c-people" name="people" type="number" min="1" max="60" value="2" inputmode="numeric" />
        </div>
      </div>

      <div class="field">
        <label for="c-msg">Anything else</label>
        <textarea id="c-msg" name="message" placeholder="Hotel preference, travelling with kids or parents, places you want to see…"></textarea>
      </div>

      <p class="error" role="alert" data-error hidden>Add your name so we know who we’re talking to.</p>

      <div class="form-actions">
        <button class="btn btn--teal" type="submit" data-via="whatsapp">Send on WhatsApp</button>
        <button class="btn btn--line" type="submit" data-via="email">Send by email</button>
      </div>
    </form>

    <aside class="details" aria-label="Contact details">
      <div>
        <h2>WhatsApp</h2>
        <a class="big" href={whatsappLink('Hi Aaroma Holidays, I would like help planning a trip.')} target="_blank" rel="noopener">{site.phones[0].display}</a>
      </div>
      <div>
        <h2>Call</h2>
        {site.phones.map((p) => <a class="big" href={`tel:${p.tel}`}>{p.display}</a>)}
      </div>
      <div>
        <h2>Email</h2>
        <a class="big" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div>
        <h2>Office</h2>
        <address>
          {site.address.line1}<br />
          {site.address.line2}<br />
          {site.address.country}
        </address>
      </div>
      <div class="map">
        <iframe
          title="Map showing Bijanbari, Darjeeling"
          src="https://maps.google.com/maps?q=Bijanbari%2C%20Darjeeling&z=12&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </aside>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: start;
    padding-bottom: var(--section);
  }

  .form {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .form h2 { font-size: var(--step-3); margin-bottom: 0.25rem; }

  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }

  .error { color: #a12a1f; font-weight: 600; }

  .form-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .form-actions .btn--line { color: var(--ink); }

  .details { display: grid; gap: 2rem; }
  .details h2 {
    margin-bottom: 0.4rem;
    color: var(--ink-muted);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .big {
    display: block;
    color: var(--ink);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .big:hover { color: var(--teal); text-decoration: underline; text-decoration-thickness: 1px; }

  address { font-style: normal; }

  .map {
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
    background: var(--teal-wash);
  }
  .map iframe { width: 100%; height: 100%; border: 0; }

  @media (max-width: 960px) {
    .contact { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const error = form?.querySelector<HTMLElement>('[data-error]');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    if (!name) {
      error!.hidden = false;
      form.querySelector<HTMLInputElement>('#c-name')?.focus();
      return;
    }
    error!.hidden = true;

    const lines = [
      `Hi Aaroma Holidays, I'm ${name}.`,
      `Trip: ${data.get('trip')}`,
      `Arrival: ${data.get('date') || 'flexible'}`,
      `Travellers: ${data.get('people')}`,
      data.get('phone') ? `Phone: ${data.get('phone')}` : '',
      data.get('message') ? `Notes: ${data.get('message')}` : '',
    ].filter(Boolean);
    const text = lines.join('\n');

    const via = (e.submitter as HTMLButtonElement | null)?.dataset.via;
    if (via === 'email') {
      location.href = `mailto:sales@aaromaholidays.com?subject=${encodeURIComponent('Trip enquiry from ' + name)}&body=${encodeURIComponent(text)}`;
    } else {
      window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    }
  });

  // Pre-select a trip when linked as /contact/?trip=<title>
  const trip = new URLSearchParams(location.search).get('trip');
  if (trip) {
    const select = form?.querySelector<HTMLSelectElement>('#c-trip');
    const opt = [...(select?.options ?? [])].find((o) => o.text.startsWith(trip));
    if (select && opt) select.value = opt.value;
  }
</script>
