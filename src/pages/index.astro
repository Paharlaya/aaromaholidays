---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PackageCard from '../components/PackageCard.astro';
import Photo from '../components/Photo.astro';
import Gallery from '../components/Gallery.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { packages } from '../data/packages';

const featured = packages.filter((p) => p.featured).slice(0, 6);

const reasons = [
  {
    title: 'Local drivers',
    text: 'Drivers who know the Darjeeling and Sikkim roads: which pass is open, where the fog sits, and where to stop for tea.',
  },
  {
    title: 'Permits sorted before you land',
    text: 'North Sikkim, Tsomgo Lake and Nathula need permits. Send your ID once and we handle the rest.',
  },
  {
    title: 'Plans that bend',
    text: 'Every package is a starting point. Add a night, swap a hotel, slow the pace for parents or kids.',
  },
  {
    title: 'A partner for travel agents',
    text: 'Travel agents can book our cabs and ground team for their Darjeeling, Sikkim and Kalimpong guests.',
  },
];
---

<Base overlayHeader>
  <Hero src="/images/hero-kanchenjunga.webp" srcPhone="/images/hero-kanchenjunga-phone.webp" />

  <section class="section" aria-labelledby="popular-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="popular-title">Our most-booked trips</h2>
        <p>
          Starting prices for our most popular routes. Each one can be changed to suit your dates and group.
          <a class="text-link" href={url('/itineraries/')}>See all itineraries</a>
        </p>
      </div>

      <div class="popular">
        {featured.map((p) => <PackageCard pkg={p} />)}
      </div>
    </div>
  </section>

  <section class="section section--wash" aria-labelledby="why-title">
    <div class="wrap why">
      <div class="why-media">
        <Photo alt="An Aaroma driver beside the cab on a mountain road" label="Driver and cab on a mountain road" tone="mist" ratio="4 / 5" />
      </div>
      <div class="why-text">
        <h2 id="why-title">Local from the first call to the last drop</h2>
        <p class="lede">
          Aaroma Holidays is based in Bijanbari, in the Darjeeling hills. We plan and run every trip
          ourselves, with our own team on the ground.
        </p>
        <dl class="reasons">
          {reasons.map((r) => (
            <div>
              <dt>{r.title}</dt>
              <dd>{r.text}</dd>
            </div>
          ))}
        </dl>
        <a class="text-link" href={url('/about/')}>More about us</a>
      </div>
    </div>
  </section>

  <section class="section gallery-section" aria-labelledby="gallery-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="gallery-title">Seen on our trips</h2>
        <p>Places our guests visit most, from Tiger Hill to Gurudongmar Lake. Tap a photo to see it full size.</p>
      </div>
    </div>
    <Gallery />
  </section>

  <EnquiryBand />
</Base>

<style>
  .section-head p { display: grid; gap: 0.75rem; justify-items: start; }

  .popular {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2.5rem, 2rem + 1.5vw, 3.5rem) clamp(1rem, 0.5rem + 1.5vw, 2rem);
  }

  .why {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: center;
  }

  .why-media { border-radius: var(--radius-lg); overflow: hidden; }

  .why-text { display: grid; gap: 1.5rem; justify-items: start; }

  .reasons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem 2rem;
    margin: 0.5rem 0;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(14 124 120 / 0.25);
  }

  dt {
    margin-bottom: 0.35rem;
    color: var(--ink);
    font-weight: 600;
  }
  dd { margin: 0; font-size: var(--step--1); line-height: 1.6; }

  @media (max-width: 960px) {
    .popular { grid-template-columns: repeat(2, 1fr); }
    .why { grid-template-columns: 1fr; }
    .why-media { max-width: 520px; }
  }

  @media (max-width: 600px) {
    .popular { grid-template-columns: 1fr; }
    .reasons { grid-template-columns: 1fr; }
  }
</style>
