---
// The Kanchenjunga skyline as seen from Darjeeling, drawn as one line.
// Used once, at the top of the footer.
---
<div class="ridge" aria-hidden="true">
  <svg viewBox="0 0 1440 90" preserveAspectRatio="none">
    <path
      d="M0 90 V70 L80 64 L150 68 L230 52 L290 58 L360 40 L410 46 L470 30 L520 36 L580 18 L620 24 L660 8 L690 16 L720 4 L760 20 L800 14 L850 34 L900 28 L960 46 L1020 40 L1090 56 L1160 50 L1240 64 L1320 58 L1440 68 V90 Z"
      fill="var(--teal-deep)"
    />
  </svg>
</div>

<style>
  .ridge { background: var(--white); line-height: 0; }
  svg { width: 100%; height: clamp(40px, 6vw, 90px); }
</style>
