---
import { url } from '../lib/url';
/**
 * A photo, or, until real photos are added, a labelled placeholder that says
 * which shot belongs here. To swap in a real image, pass `src`
 * (e.g. put files in /public/images and pass "/images/tsomgo.jpg").
 */
import type { Tone } from '../data/packages';

interface Props {
  src?: string;
  alt: string;
  label?: string;
  tone?: Tone;
  ratio?: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, label, tone = 'mist', ratio = '4 / 3', eager = false, class: cls } = Astro.props;

const tones: Record<Tone, [string, string, string, string]> = {
  // sky top, sky bottom, far ridge, near ridge
  dawn: ['#c9d9e0', '#f2d2b8', '#8aa7ae', '#3f6c6a'],
  glacier: ['#b9d3d8', '#eef4f4', '#7fa2a8', '#2f5e62'],
  mist: ['#d7e2e2', '#f4f7f6', '#9db3b2', '#557a77'],
  forest: ['#cbdcd3', '#eef3ea', '#7f9f8b', '#2f5a45'],
  lake: ['#a9c9d1', '#e3eff1', '#6f99a1', '#1f5357'],
  dusk: ['#5b7584', '#d9a98c', '#46626a', '#1d3b3d'],
};
const [skyA, skyB, far, near] = tones[tone];
---

{src ? (
  <img
    class:list={['photo', cls]}
    src={url(src)}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={`aspect-ratio:${ratio}`}
  />
) : (
  <div
    class:list={['photo', 'ph', cls]}
    role="img"
    aria-label={alt}
    style={`aspect-ratio:${ratio};--sky-a:${skyA};--sky-b:${skyB}`}
  >
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <path d="M0 210 L60 170 L110 190 L170 130 L215 160 L260 120 L320 175 L400 150 V300 H0 Z" fill={far} opacity="0.7" />
      <path d="M0 250 L70 215 L140 238 L210 200 L290 240 L350 220 L400 235 V300 H0 Z" fill={near} />
    </svg>
    {label && <span class="ph-label">Photo: {label}</span>}
  </div>
)}

<style>
  .photo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: inherit;
  }

  .ph {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--sky-a), var(--sky-b));
  }

  .ph svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ph-label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    max-width: calc(100% - 1.5rem);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.82);
    color: var(--ink-soft);
    font-size: 0.75rem;
    line-height: 1.3;
  }
</style>
