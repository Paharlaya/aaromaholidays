---
import { site, whatsappLink } from '../data/site';

interface Props {
  message?: string;
}
const { message = 'Hi Aaroma Holidays, I would like help planning a trip.' } = Astro.props;
---

<section class="band" aria-labelledby="band-title">
  <div class="wrap inner">
    <h2 id="band-title">Tell us your dates. We’ll send a day-by-day plan and a price.</h2>
    <div class="actions">
      <a class="btn btn--white" href={whatsappLink(message)} target="_blank" rel="noopener">Chat on WhatsApp</a>
      <a class="btn btn--line" href={`tel:${site.phones[0].tel}`}>Call {site.phones[0].display}</a>
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--teal);
    color: var(--white);
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem);
  }

  .inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: end;
    gap: 2rem 4rem;
  }

  h2 { color: var(--white); max-width: 20ch; }

  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-end; }
  .btn--line { color: var(--white); }
  .btn--line:hover { background: var(--white); border-color: var(--white); color: var(--ink); }

  @media (max-width: 860px) {
    .inner { grid-template-columns: 1fr; }
    .actions { justify-content: flex-start; }
  }
</style>
