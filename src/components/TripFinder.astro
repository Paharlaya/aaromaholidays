---
import { site } from '../data/site';

const destinations = [
  'Darjeeling',
  'Gangtok & East Sikkim',
  'North Sikkim (Lachen, Lachung)',
  'Darjeeling + Sikkim',
  'Kalimpong',
  'Dooars',
  'Not sure yet',
];
---

<form class="finder" data-trip-finder data-wa={site.whatsapp} action="/contact/" aria-label="Plan your trip">
  <div class="field">
    <label for="tf-where">Where to</label>
    <select id="tf-where" name="where">
      {destinations.map((d) => <option>{d}</option>)}
    </select>
  </div>
  <div class="field">
    <label for="tf-when">When</label>
    <input id="tf-when" name="when" type="month" />
  </div>
  <div class="field">
    <label for="tf-days">Days</label>
    <select id="tf-days" name="days">
      <option>2–3 days</option>
      <option selected>4–5 days</option>
      <option>6–7 days</option>
      <option>8 days or more</option>
    </select>
  </div>
  <div class="field">
    <label for="tf-people">Travellers</label>
    <input id="tf-people" name="people" type="number" min="1" max="60" value="2" inputmode="numeric" />
  </div>
  <button class="btn btn--teal" type="submit">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z"/></svg>
    Book on WhatsApp
  </button>
  <p class="note">Your trip details go straight into a WhatsApp message to our team. Check it and press send.</p>
</form>

<style>
  .finder {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 0.8fr auto;
    align-items: end;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 30px 60px -30px rgb(7 67 65 / 0.35);
  }

  .finder .btn { min-height: 48px; }

  .note {
    grid-column: 1 / -1;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 960px) {
    .finder { grid-template-columns: 1fr 1fr; }
    .finder .btn { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .finder { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-trip-finder]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const when = String(data.get('when') || '');
      const month = when
        ? new Date(`${when}-01`).toLocaleDateString('en-IN', { month: 'long', year: 'numeric' })
        : 'flexible dates';
      const msg = [
        'Hi Aaroma Holidays, I would like to book a trip.',
        `Destination: ${data.get('where')}`,
        `When: ${month}`,
        `Length: ${data.get('days')}`,
        `Travellers: ${data.get('people')}`,
      ].join('\n');
      window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
    });
  });
</script>
