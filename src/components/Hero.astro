---
import { url } from '../lib/url';
import TripFinder from './TripFinder.astro';
import { whatsappLink } from '../data/site';

interface Props {
  /** Real hero photo, e.g. "/images/hero-kanchenjunga.webp". Until set, an illustrated placeholder is shown. */
  src?: string;
  /** Portrait photo for phones (screens up to 600px wide). Falls back to `src`. */
  srcPhone?: string;
}
const { src, srcPhone } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="frame" data-hero>
    <div class="parallax" data-parallax>
    {src ? (
      <picture>
        {srcPhone && <source media="(max-width: 600px)" srcset={url(srcPhone)} type="image/webp" />}
        <img class="art photo-art" src={url(src)} alt="Kanchenjunga lit by the morning sun under a wide blue sky" fetchpriority="high" decoding="async" />
      </picture>
    ) : (
      <svg class="art" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Kanchenjunga at sunrise, seen from the Darjeeling hills">
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0f6a6c" />
            <stop offset="0.45" stop-color="#4fa5a6" />
            <stop offset="0.72" stop-color="#cfe0d6" />
            <stop offset="1" stop-color="#f1d2b4" />
          </linearGradient>
          <linearGradient id="snow" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fbe3cc" class="glow-top" />
            <stop offset="0.55" stop-color="#eef1f1" />
            <stop offset="1" stop-color="#c9d6d8" />
          </linearGradient>
          <linearGradient id="haze" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0" />
            <stop offset="0.45" stop-color="#ffffff" stop-opacity="0.75" />
            <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="shade" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#063f3d" stop-opacity="0.5" />
            <stop offset="0.55" stop-color="#000" stop-opacity="0" />
          </linearGradient>
        </defs>

        <rect width="1600" height="1000" fill="url(#sky)" />

        <!-- Kanchenjunga massif: Kabru (left), the main summits, Pandim (right) -->
        <path
          class="massif"
          d="M120 660 L300 540 L380 560 L470 470 L530 505 L600 452 L660 482 L742 378 L792 408 L842 292 L880 330 L922 308 L980 388 L1042 366 L1110 446 L1170 414 L1242 498 L1330 468 L1470 600 L1600 640 V720 H0 Z"
          fill="url(#snow)"
        />
        <!-- shadowed faces -->
        <path d="M842 292 L880 330 L870 420 L820 470 L800 420 Z" fill="#9db4bb" opacity="0.55" />
        <path d="M922 308 L980 388 L955 470 L905 420 Z" fill="#9db4bb" opacity="0.5" />
        <path d="M470 470 L530 505 L505 560 L455 540 Z" fill="#9db4bb" opacity="0.5" />
        <path d="M1170 414 L1242 498 L1205 540 L1160 500 Z" fill="#9db4bb" opacity="0.5" />
        <path d="M742 378 L792 408 L770 480 L728 450 Z" fill="#9db4bb" opacity="0.45" />

        <!-- cloud band in the valleys -->
        <rect y="520" width="1600" height="220" fill="url(#haze)" />

        <!-- foothills -->
        <path d="M0 700 C180 640 320 690 480 650 C640 610 760 680 920 640 C1080 600 1240 660 1400 630 C1500 612 1560 625 1600 620 V1000 H0 Z" fill="#6fb0ad" />
        <path d="M0 780 C160 740 300 790 470 750 C650 708 800 780 980 740 C1160 700 1320 770 1600 720 V1000 H0 Z" fill="#2f8a86" />
        <path d="M0 860 C200 820 380 880 600 840 C820 800 1000 870 1240 830 C1400 805 1520 830 1600 815 V1000 H0 Z" fill="#0f5f5c" />

        <rect width="1600" height="1000" fill="url(#shade)" />
      </svg>
    )}
    <div class="cloud-band" aria-hidden="true"></div>
    </div>

    <div class="scrim" aria-hidden="true"></div>
    <div class="veil" aria-hidden="true"></div>
    <div class="content wrap">
      <h1 id="hero-title">
        <span class="line"><span>Wake up facing</span></span>
        <span class="line"><span class="peak">Kanchenjunga</span></span>
      </h1>
      <div class="actions">
        <a class="btn btn--white" href={url('/itineraries/')}>See itineraries</a>
        <a class="btn btn--line" href={whatsappLink('Hi Aaroma Holidays, I would like help planning a trip.')} target="_blank" rel="noopener">
          Ask on WhatsApp
        </a>
      </div>
    </div>
  </div>

  <div class="finder wrap">
    <TripFinder />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(0.5rem, 0.25rem + 1vw, 1rem);
  }

  .frame {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: stretch;
    min-height: max(620px, min(calc(100svh - 2rem), 920px));
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #0f6a6c;
    color: var(--white);
  }

  .parallax {
    position: absolute;
    inset: -6% 0 0;
    will-change: transform;
  }

  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Real photo: frame the peaks, tint slightly toward the site's teal */
  .photo-art {
    object-position: 62% 50%;
    filter: saturate(0.95) hue-rotate(-6deg);
  }
  /* Phones get the portrait photo: keep the peaks just below the headline */
  @media (max-width: 600px) {
    .photo-art { object-position: 50% 40%; }
  }
  /* A faint band of valley cloud that drifts slowly across the foothills */
  .cloud-band {
    position: absolute;
    left: 0;
    top: 66%;
    width: 200%;
    height: 16%;
    opacity: 0.22;
    mix-blend-mode: screen;
    background:
      radial-gradient(ellipse 9% 40% at 6% 55%, #fff, transparent 70%),
      radial-gradient(ellipse 14% 50% at 22% 45%, #fff, transparent 70%),
      radial-gradient(ellipse 10% 35% at 38% 60%, #fff, transparent 70%),
      radial-gradient(ellipse 12% 45% at 56% 50%, #fff, transparent 70%),
      radial-gradient(ellipse 9% 40% at 72% 55%, #fff, transparent 70%),
      radial-gradient(ellipse 14% 50% at 88% 45%, #fff, transparent 70%);
    filter: blur(14px);
    pointer-events: none;
  }

  /* White mist that covers the photo on load and lifts away, peaks last */
  .veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 170%;
    background: linear-gradient(180deg, #fff 0%, #fff 52%, rgb(255 255 255 / 0.6) 70%, rgb(255 255 255 / 0) 100%);
    transform: translateY(-100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Keeps the headline readable over snow or a bright photo. */
  .scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 50% 28%, rgb(5 70 68 / 0.35), transparent 75%),
      linear-gradient(180deg, rgb(5 70 68 / 0.5) 0%, rgb(5 70 68 / 0.2) 40%, transparent 58%);
  }

  /* Headline in the sky at the top, buttons at the bottom of the hero */
  .content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-top: clamp(7rem, 5rem + 5vh, 10rem);
    /* clears the trip finder that overlaps the bottom edge on desktop */
    padding-bottom: clamp(6.75rem, 5.5rem + 2vw, 8rem);
    text-align: center;
  }

  h1 {
    color: var(--white);
    font-size: clamp(2.75rem, 1.6rem + 3.6vw, 5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  /* Each line is a window the words rise through */
  .line {
    display: block;
    padding-bottom: 0.14em;
    clip-path: inset(-0.6em -100vw 0 -100vw);
  }
  .line > span { display: inline-block; }

  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .actions .btn--line { color: var(--white); }
  .actions .btn--line:hover { background: var(--white); border-color: var(--white); color: var(--ink); }

  .finder {
    position: relative;
    z-index: 2;
    margin-top: -4.5rem;
  }

  /*
   * The one orchestrated moment — clouds parting over Kanchenjunga:
   * the frame opens, mist lifts (foothills first, peaks last), the name
   * draws into focus, then the page settles in around it.
   */
  @media (prefers-reduced-motion: no-preference) {
    .frame { animation: open-frame 1.5s cubic-bezier(0.65, 0, 0.35, 1) both; }
    .veil { animation: lift 1.9s 0.1s cubic-bezier(0.65, 0, 0.35, 1) both; }
    .photo-art { animation: settle 3.2s var(--ease) both; }
    .massif { animation: alpenglow 2.6s 0.6s var(--ease) both; }
    .cloud-band { animation: cloud-in 2s 1.6s ease-out both, cloud-drift 120s 1.6s linear infinite; }

    .line:nth-child(1) > span { animation: line-up 1.1s 1.45s var(--ease) both; }
    .line:nth-child(2) > span { animation: line-up 1.1s 1.6s var(--ease) both, focus-in 1.8s 1.6s var(--ease) both; }

    .actions { animation: rise 1s 2.1s var(--ease) both; }
    .finder { animation: rise 1s 2.25s var(--ease) both; }
  }

  @keyframes open-frame {
    from { clip-path: inset(3.5% 5% round 56px); }
    to { clip-path: inset(0 round var(--radius-lg)); }
  }
  @keyframes lift {
    from { transform: translateY(0); }
    to { transform: translateY(-100%); }
  }
  @keyframes line-up {
    from { transform: translateY(110%); }
    to { transform: none; }
  }
  @keyframes focus-in {
    from { letter-spacing: 0.22em; opacity: 0.4; }
    to { letter-spacing: -0.015em; opacity: 1; }
  }
  @keyframes cloud-in {
    from { opacity: 0; }
    to { opacity: 0.22; }
  }
  @keyframes cloud-drift {
    to { transform: translateX(-50%); }
  }

  @keyframes alpenglow {
    from { filter: brightness(0.7) saturate(0.6); }
    to { filter: none; }
  }
  @keyframes settle {
    from { transform: scale(1.14); }
    to { transform: none; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 860px) {
    .content { padding-top: 7.5rem; padding-bottom: 2rem; }
    .scrim { background: linear-gradient(180deg, rgb(5 70 68 / 0.6) 0%, rgb(5 70 68 / 0.25) 45%, transparent 65%); }
    .frame { min-height: 640px; }
    .finder { margin-top: 1rem; padding-inline: 0; }
  }

  /* Phones: shorter hero, headline higher, buttons on one row */
  @media (max-width: 600px) {
    .frame { min-height: max(530px, 67svh); }
    .content { padding-top: 6.25rem; padding-bottom: 1.5rem; }
    .actions { flex-wrap: nowrap; gap: 0.5rem; }
    .actions .btn { min-height: 44px; padding: 0.6rem 1rem; font-size: 0.9375rem; white-space: nowrap; }
  }
</style>

<script>
  // Gentle depth on scroll: the photo moves slower than the page.
  const layer = document.querySelector<HTMLElement>('[data-parallax]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (layer && !reduce.matches) {
    let ticking = false;
    const update = () => {
      const y = Math.min(window.scrollY, window.innerHeight);
      layer.style.transform = `translate3d(0, ${y * 0.22}px, 0)`;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
  }
</script>
