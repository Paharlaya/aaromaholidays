---
import { url } from '../lib/url';
import Photo from './Photo.astro';
import { formatPrice, type Package } from '../data/packages';

interface Props {
  pkg: Package;
  large?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { pkg, large = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class:list={['card', { large }]} data-tags={pkg.tags.join(' ')}>
  <a href={url(`/itineraries/${pkg.slug}/`)} class="link">
    <div class="media">
      <Photo
        src={pkg.image.src}
        alt={pkg.image.label}
        label={pkg.image.label}
        tone={pkg.image.tone}
        ratio={large ? '4 / 3.4' : '4 / 3'}
      />
    </div>
    <div class="body">
      <p class="route">{pkg.route.join(' to ')}</p>
      <Heading class="title">{pkg.title}</Heading>
      {large && <p class="summary">{pkg.summary}</p>}
      <p class="meta">
        <span>{pkg.duration}</span>
        <span class="price">From <strong>{formatPrice(pkg.priceFrom)}</strong></span>
      </p>
    </div>
  </a>
</article>

<style>
  .card { min-width: 0; }

  .link {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.1rem;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .media {
    overflow: hidden;
    border-radius: var(--radius);
  }

  .media :global(.photo) {
    transition: transform 0.6s var(--ease);
  }
  .link:hover .media :global(.photo) { transform: scale(1.03); }

  .body { display: flex; flex-direction: column; gap: 0.4rem; }

  .route {
    color: var(--teal);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .title {
    margin-bottom: 0.75rem;
    font-size: var(--step-2);
    line-height: 1.12;
  }
  .link:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .summary { max-width: 46ch; margin-top: 0.25rem; }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .price strong { color: var(--ink); font-size: var(--step-0); }

  .large .title { font-size: var(--step-3); }
</style>
